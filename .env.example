# PHANTOM — Hermes Agent Stealth Browser Engine
# Copy to .env and configure

# API server
PHANTOM_API_URL=http://localhost:8001

# Redis cache (optional — falls back to in-memory if unavailable)
REDIS_URL=redis://localhost:6379/1

# Concurrency
MAX_CONCURRENT_TASKS=3

# Browser
BROWSER_HEADLESS=true
DEFAULT_TIMEOUT_MS=30000
SCREENSHOT_DIR=./screenshots

# Stealth
RATE_LIMIT_DELAY_MS=1500
USER_AGENT_ROTATION=true

# Proxy (optional)
PROXY_URL=

# Logging
LOG_LEVEL=INFO

# API key (optional — for protected deployments)
PHANTOM_API_KEY=
